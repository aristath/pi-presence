{
  "name": "pi-presence",
  "version": "0.1.0",
  "description": "Persistent agent-state journals and context for Pi",
  "type": "module",
  "license": "UNLICENSED",
  "keywords": [
    "pi-package",
    "presence"
  ],
  "files": [
    "src",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "engines": {
    "node": ">=22.18"
  },
  "os": [
    "linux"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3",
    "typebox": "1.3.27"
  }
}
